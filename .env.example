# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/yj_developers?retryWrites=true&w=majority"

# JWT Authentication Secret for Admin Dashboard Sessions
JWT_SECRET=your_jwt_secret_key_here

# Default Admin Portal Credentials (used for initial setup & fallback login)
ADMIN_EMAIL=admin@yjdevelopers.com
ADMIN_PASSWORD=admin123456
